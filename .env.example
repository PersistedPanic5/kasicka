# Copy this file to .env and fill in the real values from your Supabase
# project (Project Settings → API). Never commit .env itself — it's
# git-ignored on purpose. See README.md "Connect Supabase".

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Web Push public key — see supabase/functions/check-recurring-due/README.md
# "Generate a VAPID key pair" for how to get this. The matching private key
# never goes here — it's an Edge Function secret only. Also needs to be set
# as a Vercel project environment variable once you have it, not just here.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
